#version 450
/*
 * DRAGON GL - GPD compute pass 1a: GPU CULLING of map tile instances.
 * (GPL-3.0-or-later, see gpd_mesh.glsl)
 *
 * DELIBERATELY SEPARATED from vertex generation: this pass only makes
 * the visibility decision (one per work item) and appends the indices
 * of visible tiles to map_visible[]. It never touches the vertex SSBO,
 * so it can be validated in isolation (the headless test reads the
 * index list back and compares it against the CPU cull reference).
 *
 * Cull radius (push constants) is a SUPERSET of what is visible: the
 * fragment shader discards everything beyond visionRadius.
 */
#include "gpd_mesh.glsl"

layout(local_size_x = 256) in;

layout(binding = 0) buffer MapInst    { GpdInstance instances[]; } map_instances;
layout(binding = 1) buffer MapVisible { uint            indices[]; } map_visible;
layout(binding = 2) buffer Counts     { GpdCounts       c; }       gpd_counts;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;

    GpdInstance it = map_instances.instances[i];

    float dx = it.a.x - pc.cull.y;
    float dz = it.a.z - pc.cull.z;
    if (dx * dx + dz * dz > pc.cull.x * pc.cull.x) return;

    /* At most pc.count slots can ever be claimed and the index buffer
     * is sized for all instances (VKD_MAP_INST_MAX), so no capacity
     * guard is needed here. */
    map_visible.indices[atomicAdd(gpd_counts.c.map_vis, 1u)] = i;
}
