#version 450
/*
 * DRAGON GL - GPD compute pass 2a: MESH ALLOCATION/EXPANSION for map
 * tiles. (GPL-3.0-or-later, see gpd_mesh.glsl)
 *
 * Consumes the index list produced by gpd_cull_map (culling is a
 * SEPARATE pass — this shader never re-evaluates visibility): it
 * reserves vertex slots for each visible tile and expands the box into
 * the vertex SSBO.
 *
 * Dispatched with ceil(map_count/256) workgroups; since
 * map_vis <= map_count, work items beyond gpd_counts.c.map_vis simply
 * exit. This avoids an indirect dispatch (no CPU readback of the cull
 * count, no second dependency edge).
 */
#include "gpd_mesh.glsl"

layout(local_size_x = 256) in;

layout(binding = 0) buffer MapInst    { GpdInstance instances[]; } map_instances;
layout(binding = 1) buffer MapVisible { uint            indices[]; } map_visible;
layout(binding = 2) buffer Counts     { GpdCounts       c; }       gpd_counts;
layout(binding = 3) buffer Verts      { GpdVertex       verts[]; } gpd_verts;

#include "gpd_ops.glsl"

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= gpd_counts.c.map_vis) return;

    GpdInstance it = map_instances.instances[map_visible.indices[i]];

    uint base;
    if (!gpd_reserve(36u, base)) return;
    gpd_expand_box(base, it.a.xyz, it.b.xyz, it.c);
}
