# Professional Startup Script

# DragonGL Client Launcher
cat << "EOF"
###############################################################################
#                                                                             #
#                      Dragon GL - Arcane Game Engine                         #
#                              CLIENT MODULE                                  #
#                                                                             #
###############################################################################
EOF

show_help() {
    echo -e "\nUsage: $0 [opzioni] <backend> [server_ip] [port]"
    echo "Options:"
    echo "  -h, --help    Shows this help message"
    echo -e "\nBackend:"
    echo "  gl            Start with OpenGL backend (Legacy)"
    echo "  vk            Start with Vulkan backend (Modern)"
    echo -e "\nConnection (optional, skips the interactive prompt):"
    echo "  server_ip     IP/hostname of the game server (default 127.0.0.1)"
    echo "  port          TCP port of the game server (default 8080)"
    echo -e "\nExample:"
    echo "  $0 gl 192.168.1.10 9000"
}

# Check if executable exists
BIN="./build/dragongl_client"
if [ ! -f "$BIN" ]; then
    echo -e "\n[ERROR] Client executable not found in build/."
    echo "Compile the project with:"
    echo "  cd build && cmake .. && make -j\$(nproc)"
    exit 1
fi

# Parsing parametri
BACKEND=""
SERVER_IP=""
PORT=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        gl|vk)
            BACKEND="$1"
            shift
            ;;
        *)
            # First non-backend positional = server IP, second = port
            if [ -z "$SERVER_IP" ]; then
                SERVER_IP="$1"
            elif [ -z "$PORT" ]; then
                PORT="$1"
            else
                echo "Unknown option: $1"
                show_help
                exit 1
            fi
            shift
            ;;
    esac
done

if [ -z "$BACKEND" ]; then
    show_help
    exit 1
fi

# Start the client from root (data/ e saves/ sono relativi a questa directory)
cd "$(dirname "$0")"

# Quoted expansion: no word-splitting even if the IP contained spaces (it
# shouldn't, but the launcher must not misbehave).
exec "$BIN" "$BACKEND" "$SERVER_IP" "$PORT"
