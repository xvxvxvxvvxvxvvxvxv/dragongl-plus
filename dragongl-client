# Usage: dragongl-client [gl|vk] [server_ip] [port] [--fullscreen|--windowed]
# Every argument is optional and passed to dragongl_client unchanged
# (with no argument the game opens on its title menu).

case "$1" in
-h|--help)
    cat <<'TXT'
Usage: dragongl-client [gl|vk] [server_ip] [port] [--fullscreen|--windowed]

  gl            OpenGL 3.3 renderer (default)
  vk            Vulkan 1.3 renderer (falls back to OpenGL if unavailable)
  server_ip     pre-fill the "Join a Server" form
  port          TCP port of the server (default 8080)

Example:  dragongl-client vk 192.168.1.10 9000
TXT
    exit 0
    ;;
esac

HERE=$(cd "$(dirname "$0")" && pwd)
for BIN in "$HERE/build/dragongl_client" "$HERE/dragongl_client"; do
    [ -x "$BIN" ] && exec "$BIN" "$@"
done
if command -v dragongl_client >/dev/null 2>&1; then
    exec dragongl_client "$@"
fi
echo "[ERROR] dragongl_client not found. Build it first:" >&2
echo "  cmake -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j" >&2
exit 1
